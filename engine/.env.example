# Copy to engine/.env for local use. Never commit real values.

# OAuth app credentials from the Tastytrade developer portal.
TASTY_CLIENT_ID=
TASTY_CLIENT_SECRET=
# Must exactly match a redirect URI registered on your OAuth application.
TASTY_REDIRECT_URI=http://127.0.0.1:8182/callback

# Written by `svyable auth` after interactive OAuth approval.
TASTY_REFRESH_TOKEN=
TASTY_ACCOUNT_NUMBER=

# Safe default. Set false only for a real Tastytrade account.
TASTY_IS_TEST=true

# Svyable environment and output isolation.
SVYABLE_ENV=sandbox
SVYABLE_OUTPUT_ROOT=outputs

# Must remain false until production controls are satisfied.
# Even when true, live orders and production cancels require account-number confirmation.
SVYABLE_ENABLE_LIVE=false

# Optional explicit append-only broker audit path. Audit logs redact secrets/account IDs.
SVYABLE_TASTY_AUDIT_PATH=outputs/audit/tastytrade.jsonl

# Signed slippage is positive when execution is worse for either buys or sells.
SVYABLE_SLIPPAGE_WARN_BPS=15
SVYABLE_SLIPPAGE_CRITICAL_BPS=30

# Optional sandbox-only session fallback for the REST data transport.
# OAuth refresh-token credentials above remain canonical and are required for SDK execution.
TASTY_USERNAME=
TASTY_PASSWORD=

# Optional local server overrides.
SVYABLE_STREAMLIT_ADDRESS=127.0.0.1
SVYABLE_STREAMLIT_PORT=8501

# Legacy aliases TT_CLIENT_SECRET, TT_REFRESH_TOKEN, TT_ACCOUNT, TT_USERNAME,
# TT_PASSWORD, and TT_ENV are accepted during migration, but TASTY_* names are canonical.
