# Copy to engine/.env. Never commit the real file.

# OAuth credentials generated from the Tastytrade developer portal.
TASTY_CLIENT_SECRET=replace_me
TASTY_REFRESH_TOKEN=replace_me

# Pin the exact account the dashboard is allowed to observe/manage.
TASTY_ACCOUNT_NUMBER=replace_me

# Safe default. Set false only for a real Tastytrade account.
TASTY_IS_TEST=true

# Svyable environment and output isolation.
SVYABLE_ENV=sandbox
SVYABLE_OUTPUT_ROOT=outputs

# Must remain false until every production gate in the canonical README passes.
# Even when true, live orders require typed account-number confirmation.
SVYABLE_ENABLE_LIVE=false

# Signed slippage is positive when execution is worse for either buys or sells.
SVYABLE_SLIPPAGE_WARN_BPS=15
SVYABLE_SLIPPAGE_CRITICAL_BPS=30

# Optional local server overrides.
SVYABLE_STREAMLIT_ADDRESS=127.0.0.1
SVYABLE_STREAMLIT_PORT=8501

# Optional explicit append-only broker audit path.
# SVYABLE_TASTY_AUDIT_PATH=outputs/audit/tastytrade.jsonl

# Legacy aliases TT_CLIENT_SECRET, TT_REFRESH_TOKEN, TT_ACCOUNT and TT_ENV
# are accepted during migration, but TASTY_* names are canonical.
