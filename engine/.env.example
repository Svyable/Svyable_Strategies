# Copy to engine/.env for local use. Never commit real values.
#
# Streamlit can switch SANDBOX ⇄ PRODUCTION at runtime. Prefer the profile-
# specific names below so each mode has isolated OAuth tokens/accounts. The
# generic TASTY_* names remain accepted as a fallback for single-profile installs.

# --- Sandbox / cert profile -------------------------------------------------
# OAuth app credentials from the Tastytrade developer portal / sandbox account.
TASTY_SANDBOX_CLIENT_ID=
TASTY_SANDBOX_CLIENT_SECRET=
# Must exactly match a redirect URI registered on your OAuth application.
TASTY_SANDBOX_REDIRECT_URI=http://127.0.0.1:8182/callback

# Written by the Streamlit "Authorize Tastytrade sandbox" button or `svyable auth`.
TASTY_SANDBOX_REFRESH_TOKEN=
TASTY_SANDBOX_ACCOUNT_NUMBER=

# --- Production profile -----------------------------------------------------
# Fill these only when production observation is intentionally configured.
TASTY_PROD_CLIENT_ID=
TASTY_PROD_CLIENT_SECRET=
TASTY_PROD_REDIRECT_URI=http://127.0.0.1:8182/callback
TASTY_PROD_REFRESH_TOKEN=
TASTY_PROD_ACCOUNT_NUMBER=

# --- Backward-compatible single-profile fallback ----------------------------
# Existing installs can keep using these. Profile-specific names above win.
TASTY_CLIENT_ID=
TASTY_CLIENT_SECRET=
TASTY_REDIRECT_URI=http://127.0.0.1:8182/callback
TASTY_REFRESH_TOKEN=
TASTY_ACCOUNT_NUMBER=

# Safe default for CLI commands that do not use the Streamlit runtime selector.
# Streamlit stores the selected broker profile in session state instead.
TASTY_IS_TEST=true

# Svyable environment and output isolation.
SVYABLE_ENV=sandbox
SVYABLE_OUTPUT_ROOT=outputs

# Must remain false until production controls are satisfied.
# Even when true, live orders and production cancels require account-number confirmation.
SVYABLE_ENABLE_LIVE=false

# Optional explicit append-only broker audit paths. Audit logs redact secrets/account IDs.
SVYABLE_SANDBOX_TASTY_AUDIT_PATH=outputs/audit/tastytrade.jsonl
SVYABLE_PROD_TASTY_AUDIT_PATH=outputs-production/audit/tastytrade.jsonl
# Generic fallback if the profile-specific path is unset.
SVYABLE_TASTY_AUDIT_PATH=

# Signed slippage is positive when execution is worse for either buys or sells.
SVYABLE_SLIPPAGE_WARN_BPS=15
SVYABLE_SLIPPAGE_CRITICAL_BPS=30

# Optional local server overrides.
SVYABLE_STREAMLIT_ADDRESS=127.0.0.1
SVYABLE_STREAMLIT_PORT=8501

# Legacy aliases TT_CLIENT_SECRET, TT_REFRESH_TOKEN, TT_ACCOUNT, TT_CLIENT_ID,
# TT_REDIRECT_URI, and TT_ENV are accepted during migration, but TASTY_* names
# are canonical. Username/password session auth is deprecated and ignored.
